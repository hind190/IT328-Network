    }

    private void startCountdown(int seconds) {
        System.out.println(">>> TIMER STARTED with " + seconds + " seconds");
        
        if (timerLabel == null) {
            System.out.println("ERROR: timerLabel is null, cannot start timer");
            return;
        }
        
        if (countdownTimer != null) {
            countdownTimer.stop();
            countdownTimer = null;
        }
        
        timeLeft = seconds;
        updateTimerLabel();
        
        countdownTimer = new Timer(1000, new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                if (timeLeft > 0) {
                    timeLeft--;
                    updateTimerLabel();
                    System.out.println("Time left: " + timeLeft);
                    
                    if (timeLeft == 30) {
                        timerLabel.setForeground(Color.RED);
                        appendMessage("⚠️ 30 seconds left!");
                    }
                    
                    if (timeLeft <= 0) {
                        countdownTimer.stop();
                        appendMessage("⏱ Time is up!");
                        System.out.println(">>> TIMER FINISHED");
                    }
                } else {
                    countdownTimer.stop();
                }
            }
        });
        countdownTimer.setInitialDelay(0);
        countdownTimer.start();
    }

    private void stopCountdown() {
        if (countdownTimer != null) {
            countdownTimer.stop();
            countdownTimer = null;
        }
    }

    private void updateTimerLabel() {
        if (timerLabel != null) {
            int mins = timeLeft / 60;
            int secs = timeLeft % 60;
            timerLabel.setText(String.format("⏱ %02d:%02d", mins, secs));
        }
    }

    private void sendPlay() {
        if (connected && !waitingListModel.contains(username)) {
            out.println("PLAY");
        }
    }

    private void sendLeave() {
        if (!connected) return;

        int choice = JOptionPane.showConfirmDialog(
                this, "Leave game?", "Confirm", JOptionPane.YES_NO_OPTION);

        if (choice == JOptionPane.YES_OPTION) {
            out.println("LEAVE");

if (gameFrame != null) {
    hideGameFrame();
}
            waitingListModel.removeElement(username);
            playBtn.setEnabled(true);
            hideGameFrame();
        }
    }

    private void sendAnswer() {
        String answer = answerField.getText().trim();
        if (answer.isEmpty()) {
            appendMessage("⚠️ Please enter an answer!");
            return;
        }
         
        out.println("ANSWER:" + currentRound + ":" + answer);
        answerField.setText("");
        appendMessage("📤 تم إرسال إجابتك: " + answer);
    }

    private void appendMessage(String msg) {
        chatArea.append(msg + "\n");
        chatArea.setCaretPosition(chatArea.getDocument().getLength());
    }

