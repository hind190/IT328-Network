package server;

import java.io.IOException;
import java.net.ServerSocket;
import java.net.Socket;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Timer;
import java.util.TimerTask;

public class Server {

    private ServerSocket serverSocket;
    private List<ClientHandler> clients = new ArrayList<>();
    private WaitingRoom waitingRoom;
    private boolean running = true;
    private GameLogic gameLogic;

    private List<ClientHandler> gamePlayers = Collections.synchronizedList(new ArrayList<>());
    private int currentRound = 0;
    private boolean gameActive = false;
    private final int TOTAL_ROUNDS = 5;
    private final int MAX_PLAYERS = 4;
    private Timer gameStartTimer;
    private boolean waitingForPlayers = false;

    public Server() {
        this.gameLogic = new GameLogic(this);
        this.waitingRoom = new WaitingRoom(this);
    }

    public void start(int port) {
        try {
            serverSocket = new ServerSocket(port);
            System.out.println("Server is running on port " + port);

            while (running) {
                Socket socket = serverSocket.accept();
                System.out.println("New client connected: " + socket.getInetAddress());
                ClientHandler clientHandler = new ClientHandler(socket, this);
                clientHandler.start();
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    public GameLogic getGameLogic() {
        return gameLogic;
    }

    public synchronized List<ClientHandler> getClients() {
        return clients;
    }

    public List<ClientHandler> getGamePlayers() {
        return gamePlayers;
    }

    public int getWaitingRoomSize() {
        return waitingRoom.getPlayerCount();
    }

    public List<ClientHandler> getWaitingRoomPlayers() {
        return waitingRoom.getAllPlayers();
    }

    public synchronized void addClient(ClientHandler client) {
        clients.add(client);
    }

    public synchronized void removeClient(ClientHandler client) {
        clients.remove(client);
        waitingRoom.removePlayer(client);
        gamePlayers.remove(client);
    }

    public synchronized void broadcastPlayerList() {
        if (clients.isEmpty()) return;

        StringBuilder sb = new StringBuilder("PLAYER_LIST:");
        for (int i = 0; i < clients.size(); i++) {
            if (i > 0) sb.append(",");
            sb.append(clients.get(i).getUsername());
        }
        String msg = sb.toString();

        for (ClientHandler c : clients) {
            c.sendMessage(msg);
        }
    }

    public void addToWaitingRoom(ClientHandler handler) {
        waitingRoom.addPlayer(handler);
        broadcastWaitingRoomPlayers();
        checkAndStartGameCountdown();
    }

    public void removeFromWaitingRoom(ClientHandler handler) {
        waitingRoom.removePlayer(handler);
        broadcastWaitingRoomPlayers();
        
        if (waitingForPlayers && waitingRoom.getPlayerCount() < 2) {
            cancelGameStartTimer();
        }
    }
    
    private void broadcastWaitingRoomPlayers() {
        List<ClientHandler> waitingPlayers = waitingRoom.getAllPlayers();
        StringBuilder sb = new StringBuilder("WAITING_LIST:");
        for (int i = 0; i < waitingPlayers.size(); i++) {
            if (i > 0) sb.append(",");
            sb.append(waitingPlayers.get(i).getUsername());
        }
        String msg = sb.toString();
        
        for (ClientHandler player : waitingPlayers) {
            player.sendMessage(msg);
        }
        for (ClientHandler c : clients) {
            c.sendMessage(msg);
        }
    }
    
    private void checkAndStartGameCountdown() {
        int playerCount = waitingRoom.getPlayerCount();
        
        if (playerCount == MAX_PLAYERS && !gameActive) {
            System.out.println("4 players reached! Starting game immediately...");
            if (gameStartTimer != null) {
                gameStartTimer.cancel();
                gameStartTimer = null;
            }
            waitingForPlayers = false;
            startGame();
            return;
        }
        
        if (playerCount >= 2 && !gameActive && !waitingForPlayers && playerCount < MAX_PLAYERS) {
            startGameCountdown();
        }
    }
    
    private void startGameCountdown() {
        waitingForPlayers = true;
        
        String countdownMsg = "COUNTDOWN:30 seconds until game starts. Waiting for " + 
                              (MAX_PLAYERS - waitingRoom.getPlayerCount()) + " more player(s)...";
        for (ClientHandler player : waitingRoom.getAllPlayers()) {
            player.sendMessage(countdownMsg);
        }
        
        gameStartTimer = new Timer();
        gameStartTimer.schedule(new TimerTask() {
            @Override
            public void run() {
                if (waitingForPlayers && !gameActive && waitingRoom.getPlayerCount() >= 2) {
                    startGame();
                }
                waitingForPlayers = false;
            }
        }, 30000);
    }
    
    private void cancelGameStartTimer() {
        if (gameStartTimer != null) {
            gameStartTimer.cancel();
            gameStartTimer = null;
        }
        waitingForPlayers = false;
        
        String cancelMsg = "COUNTDOWN_CANCELLED:Not enough players. Waiting for more players...";
        for (ClientHandler player : waitingRoom.getAllPlayers()) {
            player.sendMessage(cancelMsg);
        }
    }

    public synchronized void startGame() {
        if (gameActive) return;

        if (waitingRoom.getPlayerCount() < 2) {
            broadcastToAll("ERROR:Not enough players");
            return;
        }
        
        if (gameStartTimer != null) {
            gameStartTimer.cancel();
            gameStartTimer = null;
        }
        waitingForPlayers = false;

        System.out.println("GAME STARTED with " + waitingRoom.getPlayerCount() + " players");
        gameActive = true;
        currentRound = 0;
        
        gamePlayers.clear();
        gamePlayers.addAll(waitingRoom.getAllPlayers());
        waitingRoom.clear();

        gameLogic.onGameStart();
        broadcastToGamePlayers("GAME_START");
        
        nextRound();
    }

    public synchronized void nextRound() {
        if (!gameActive) return;

        currentRound++;

        System.out.println("Starting round " + currentRound + " of " + TOTAL_ROUNDS);

        if (currentRound > TOTAL_ROUNDS) {
            gameLogic.endGame();
            return;
        }

        String roundMsg = "ROUND:" + currentRound + "/" + TOTAL_ROUNDS;
        broadcastToGamePlayers(roundMsg);
        
        gameLogic.startRound(currentRound, gamePlayers.size());
    }

    public synchronized void endGame(String winnerName) {
        if (!gameActive) return;

        gameActive = false;
        
        if (gameStartTimer != null) {
            gameStartTimer.cancel();
            gameStartTimer = null;
        }

        String endMsg;
        if (winnerName != null && !winnerName.isEmpty()) {
            endMsg = "GAME_END:" + winnerName;
            System.out.println("Winner: " + winnerName);
        } else {
            endMsg = "GAME_END:NO_WINNER";
            System.out.println("No winner - Game ended without a winner");
        }

        broadcastToAll(endMsg);
        gamePlayers.clear();
    }

    public void broadcastToAll(String message) {
        synchronized (clients) {
            for (ClientHandler c : clients) {
                c.sendMessage(message);
            }
        }
    }

    public void broadcastToGamePlayers(String message) {
        synchronized (gamePlayers) {
            for (ClientHandler c : gamePlayers) {
                c.sendMessage(message);
            }
        }
    }

    public void broadcastScores(String scoresData) {
        broadcastToAll("SCORE:" + scoresData);
    }
    
    public void updateScores() {
        String scoresData = gameLogic.getFormattedScores();
        if (scoresData != null && !scoresData.isEmpty()) {
            broadcastScores(scoresData);
        }
    }

    public synchronized void handlePlayerLeave(ClientHandler player) {
        String username = player.getUsername();
        System.out.println("Player left: " + username);

        gamePlayers.remove(player);
        waitingRoom.removePlayer(player);
        
        broadcastToAll("PLAYER_LEFT:" + username);
        broadcastPlayerList();
        broadcastWaitingRoomPlayers();

        if (gameActive) {
            if (gamePlayers.size() == 1) {
                String winner = gamePlayers.get(0).getUsername();
                broadcastToAll("PLAYER_WON:" + winner + " (All other players left)");
                endGame(winner);
            } else if (gamePlayers.isEmpty()) {
                endGame(null);
            } else {
                updateScores();
            }
        }
    }

    public void receiveAnswer(ClientHandler player, String answer, int round) {
        if (!gameActive) {
            player.sendMessage("ERROR:Game not active");
            return;
        }

        System.out.println("Answer from " + player.getUsername() + ": " + answer);
        gameLogic.submitAnswer(player.getUsername(), answer);
        
        updateScores();
    }
    
    public void playerReadyToPlay(ClientHandler player) {
        if (!gameActive && !waitingRoom.isPlayerInRoom(player)) {
            addToWaitingRoom(player);
            player.sendMessage("WAITING_ROOM_JOINED:You are now in the waiting room");
        }
    }

    public static void main(String[] args) {
        new Server().start(1234);
    }
}
