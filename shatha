    private void setLevelImage(String path) {
        try {
            ImageIcon icon = new ImageIcon(IMAGE_PATH + path);
            Image img = icon.getImage();
            Dimension screenSize = Toolkit.getDefaultToolkit().getScreenSize();
            int imgWidth = (int)(screenSize.width * 0.6);
            int imgHeight = (int)(screenSize.height * 0.4);
            Image scaledImg = img.getScaledInstance(imgWidth, imgHeight, Image.SCALE_SMOOTH);
            imageLabel.setIcon(new ImageIcon(scaledImg));
        } catch (Exception e) {
            System.out.println("Error loading image: " + path);
        }
    }
    
