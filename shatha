    private void connectToServer() {
        if (connected) return;

        String name = usernameField.getText().trim();
        if (name.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Enter username");
            return;
        }

        try {
            socket = new Socket("localhost", 1234);
            out = new PrintWriter(socket.getOutputStream(), true);
            in = new BufferedReader(new InputStreamReader(socket.getInputStream()));

            username = name;
            out.println("CONNECT:" + username);
            connected = true;
            startListener();

            connectBtn.setEnabled(false);
            usernameField.setEnabled(false);
            playBtn.setEnabled(true);
            leaveBtn.setEnabled(true);

            JOptionPane.showMessageDialog(this, "Connected Successfully 🎉");

        } catch (IOException e) {
            JOptionPane.showMessageDialog(this, "Cannot connect to server! Make sure the server is running.");
        }
    }

    private void startListener() {
        if (listenerStarted) return;
        listenerStarted = true;

        new Thread(() -> {
            try {
                String msg;
                while ((msg = in.readLine()) != null) {
                    String finalMsg = msg;
                    SwingUtilities.invokeLater(() -> processMessage(finalMsg));
                }
            } catch (IOException e) {
                SwingUtilities.invokeLater(() -> appendMessage("Connection lost"));
            }
        }).start();
    }

    private void startCooldown() {
        stopCooldown();
        cooldownTimeLeft = 30;
        updateCooldownLabel();
        
        cooldownTimer = new Timer(1000, e -> {
            cooldownTimeLeft--;
            updateCooldownLabel();
            
            if (cooldownTimeLeft <= 0) {
                stopCooldown();
                answerField.setEnabled(true);
                submitBtn.setEnabled(true);
                cooldownLabel.setText("");
                appendMessage("✅ يمكنك الإجابة الآن!");
            }
        });
        cooldownTimer.start();
    }
    
    private void stopCooldown() {
        if (cooldownTimer != null) {
            cooldownTimer.stop();
            cooldownTimer = null;
        }
    }
    
    private void updateCooldownLabel() {
        cooldownLabel.setText("⏳ انتظر " + cooldownTimeLeft + " ثانية قبل الإجابة مرة أخرى...");
    }

    // ✅ التايمر المعدل الذي يعمل بشكل صحيح
    private void startCountdown(int seconds) {
        // إيقاف التايمر القديم إذا كان موجود
        if (countdownTimer != null) {
            countdownTimer.stop();
            countdownTimer = null;
        }
        
        timeLeft = seconds;
        updateTimerDisplay();
        System.out.println("Timer started with " + seconds + " seconds"); // للتحقق
        
        countdownTimer = new Timer(1000, new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                if (timeLeft > 0) {
                    timeLeft--;
                    updateTimerDisplay();
                    System.out.println("Timer: " + timeLeft + " seconds left"); // للتحقق
                    
                    if (timeLeft == 30) {
                        timerLabel.setForeground(Color.RED);
                        appendMessage("⚠️ تبقت 30 ثانية!");
                    }
                    
                    if (timeLeft <= 0) {
                        countdownTimer.stop();
                        appendMessage("⏱ انتهى وقت اللعبة!");
                    }
                } else {
                    countdownTimer.stop();
                }
            }
        });
        countdownTimer.setInitialDelay(0);
        countdownTimer.start();
    }
    
    private void updateTimerDisplay() {
        int mins = timeLeft / 60;
        int secs = timeLeft % 60;
        timerLabel.setText(String.format("⏱ %d:%02d", mins, secs));
    }
    
    private void stopCountdown() {
        if (countdownTimer != null) {
            countdownTimer.stop();
            countdownTimer = null;
        }
    }

    private void processMessage(String msg) {
        System.out.println("MSG: " + msg);

        if (msg.startsWith("PLAYER_LIST:")) {
            connectedListModel.clear();
            String names = msg.substring(12);
            if (!names.trim().isEmpty()) {
                HashSet<String> unique = new HashSet<>();
                for (String n : names.split(",")) {
                    n = n.trim();
                    if (!n.isEmpty() && unique.add(n)) {
                        connectedListModel.addElement(n);
                    }
                }
            }
        }
        else if (msg.startsWith("WAITING_LIST:")) {
            waitingListModel.clear();
            String names = msg.substring(13);
            if (!names.trim().isEmpty()) {
                HashSet<String> unique = new HashSet<>();
                for (String n : names.split(",")) {
                    n = n.trim();
                    if (!n.isEmpty() && unique.add(n)) {
                        waitingListModel.addElement(n);
                    }
                }
            }
        }
        else if (msg.startsWith("WAITING_FULL:")) {
            JOptionPane.showMessageDialog(this, msg.substring(13));
            playBtn.setEnabled(true);
        }
        else if (msg.startsWith("PLAY_OK")) {
            playBtn.setEnabled(false);
            appendMessage("✅ تم الانضمام إلى غرفة الانتظار");
        }
        else if (msg.startsWith("WAITING_JOINED:")) {
            appendMessage("✅ " + msg.substring(15));
        }
        else if (msg.startsWith("LEFT")) {
            playBtn.setEnabled(true);
            appendMessage("🚪 غادرت غرفة الانتظار");
        }
        else if (msg.startsWith("PLAYER_LEFT:")) {
            String who = msg.substring(12);
            appendMessage("⚠️ " + who + " غادر اللعبة");
            connectedListModel.removeElement(who);
            waitingListModel.removeElement(who);
        }
        else if (msg.startsWith("GAME_START")) {
            showGameFrame();
            answerField.setEnabled(true);
            submitBtn.setEnabled(true);
            setLevelImage("level1.png");
            appendMessage("🎮 بدأت اللعبة!");
        }
        else if (msg.startsWith("GAME_TIMER:")) {
            int seconds = Integer.parseInt(msg.substring(11));
            System.out.println("Received GAME_TIMER: " + seconds);
            startCountdown(seconds);
        }
        else if (msg.startsWith("ROUND:")) {
            roundLabel.setText("الجولة: " + msg.substring(6));
            answerField.setEnabled(true);
            submitBtn.setEnabled(true);
            answerField.setText("");
            stopCooldown();
            cooldownLabel.setText("");
        }
        else if (msg.startsWith("QUESTION:")) {
            String[] parts = msg.split(":");
            currentRound = Integer.parseInt(parts[1]);
            String imageName = parts[2];
            answerField.setEnabled(true);
            submitBtn.setEnabled(true);
            answerField.setText("");
            answerField.requestFocus();
            setLevelImage(imageName);
            appendMessage("📝 سؤال جديد! اكتب إجابتك...");
        }
        else if (msg.startsWith("CORRECT:")) {
            String who = msg.substring(8);
            appendMessage("✅ " + who + " أجاب إجابة صحيحة!");
            answerField.setEnabled(false);
            submitBtn.setEnabled(false);
            stopCooldown();
            cooldownLabel.setText("");
            if (who.equals(username)) {
                appendMessage("🎉 إجابتك صحيحة! انتظر الجولة القادمة...");
            }
        }
        else if (msg.startsWith("WRONG:")) {
            String who = msg.substring(6);
            appendMessage("❌ " + who + " أجاب إجابة خاطئة!");
            if (who.equals(username)) {
                answerField.setEnabled(false);
                submitBtn.setEnabled(false);
                startCooldown();
            }
        }
        else if (msg.startsWith("COOLDOWN_START:")) {
            String who = msg.substring(15);
            appendMessage("⏰ " + who + " يجب أن ينتظر 30 ثانية قبل الإجابة مرة أخرى!");
        }
        else if (msg.startsWith("COOLDOWN_END:")) {
            String who = msg.substring(13);
            appendMessage("✅ " + who + " يمكنه الإجابة الآن!");
            if (who.equals(username)) {
                answerField.setEnabled(true);
                submitBtn.setEnabled(true);
                stopCooldown();
                cooldownLabel.setText("");
            }
        }
        else if (msg.startsWith("ON_COOLDOWN:")) {
            String who = msg.substring(12);
            appendMessage("⏰ " + who);
        }
        else if (msg.startsWith("ROUND_END:")) {
            String winner = msg.substring(10);
            appendMessage("🏁 " + winner + " أجاب إجابة صحيحة! الانتقال للجولة التالية...");
            answerField.setEnabled(false);
            submitBtn.setEnabled(false);
            stopCooldown();
            cooldownLabel.setText("");
        }
        else if (msg.startsWith("ROUND_ENDED:")) {
            appendMessage("⚠️ " + msg.substring(12));
            answerField.setEnabled(false);
            submitBtn.setEnabled(false);
        }
        else if (msg.startsWith("ALREADY_CORRECT:")) {
            appendMessage("⚠️ لقد أجبت إجابة صحيحة بالفعل في هذه الجولة!");
            answerField.setEnabled(false);
            submitBtn.setEnabled(false);
        }
        else if (msg.startsWith("NO_CORRECT:")) {
            appendMessage("😅 " + msg.substring(11));
            answerField.setEnabled(false);
            submitBtn.setEnabled(false);
            stopCooldown();
            cooldownLabel.setText("");
        }
        else if (msg.startsWith("SCORE:")) {
            scoreLabel.setText("<html><div style='text-align: center; font-size: 20px;'>" + msg.substring(6).replace(",", "<br>") + "</div></html>");
        }
        else if (msg.startsWith("GAME_END:")) {
            stopCountdown();
            stopCooldown();
            String winner = msg.substring(9);

            answerField.setEnabled(false);
            submitBtn.setEnabled(false);

            if (winner.equals("NO_WINNER")) {
                setLevelImage("gameover.png");
                JOptionPane.showMessageDialog(gameFrame != null ? gameFrame : this, "⏱ انتهى الوقت! لا يوجد فائز.");
                appendMessage("⏱ انتهت اللعبة - لا يوجد فائز");
            } else if (winner.equals(username)) {
                setLevelImage("winner.png");
                JOptionPane.showMessageDialog(gameFrame != null ? gameFrame : this, "🏆 لقد فزت!");
                appendMessage("🏆 أنت الفائز!");
            } else {
                setLevelImage("gameover.png");
                JOptionPane.showMessageDialog(gameFrame != null ? gameFrame : this, "انتهت اللعبة! الفائز: " + winner);
                appendMessage("🏆 الفائز: " + winner);
            }
            
            hideGameFrame();
            playBtn.setEnabled(true);
        }
    }

    private void sendPlay() {
        if (connected && !waitingListModel.contains(username)) {
            out.println("PLAY");
        }
    }

    private void sendLeave() {
        if (!connected) return;

        int choice = JOptionPane.showConfirmDialog(
                this, "هل تريد مغادرة اللعبة؟", "تأكيد", JOptionPane.YES_NO_OPTION);

        if (choice == JOptionPane.YES_OPTION) {
            out.println("LEAVE");
            waitingListModel.removeElement(username);
            playBtn.setEnabled(true);
            hideGameFrame();
        }
    }

    private void sendAnswer() {
        String answer = answerField.getText().trim();
        if (answer.isEmpty()) {
            appendMessage("⚠️ الرجاء إدخال إجابة!");
            return;
        }
        if (answer.length() > 10) {
            appendMessage("⚠️ الإجابة طويلة جداً! الحد الأقصى 10 حروف.");
            return;
        }
        out.println("ANSWER:" + currentRound + ":" + answer);
        answerField.setText("");
    }

    private void appendMessage(String msg) {
        chatArea.append(msg + "\n");
        chatArea.setCaretPosition(chatArea.getDocument().getLength());
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(GameClient::new);
    }
