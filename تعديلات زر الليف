private void sendLeave() {
    if (!connected) return;

    int choice = JOptionPane.showConfirmDialog(
            this, "Leave game?", "Confirm", JOptionPane.YES_NO_OPTION);

    if (choice == JOptionPane.YES_OPTION) {
        out.println("LEAVE");
        
        // ✅ مسح القوائم محلياً
        waitingListModel.removeElement(username);
        connectedListModel.removeElement(username);
        
        playBtn.setEnabled(true);
        hideGameFrame();
        appendMessage("🚪 You left the waiting room");
    }
}


 Server.java- دالة handlePlayerLeave (موجودة بالفعل

public synchronized void handlePlayerLeave(ClientHandler player) {
    String username = player.getUsername();
    System.out.println("Player left: " + username);

    gamePlayers.remove(player);
    waitingRoom.removePlayer(player);
    
    // ✅ إزالة اللاعب من النتائج
    gameLogic.removePlayerFromScores(username);
    
    broadcastToAll("PLAYER_LEFT:" + username);
    broadcastPlayerList();
    broadcastWaitingRoomPlayers();
    
    // ✅ تحديث النتائج للجميع
    updateScores();

    if (gameActive) {
        if (gamePlayers.size() == 1) {
            String winner = gamePlayers.get(0).getUsername();
            broadcastToAll("PLAYER_WON:" + winner + " (All other players left)");
            endGame(winner);
        } else if (gamePlayers.isEmpty()) {
            endGame(null);
        }
    }
}



